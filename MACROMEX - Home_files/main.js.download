var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
})

$(document).on("click", "a[href='#']", function (e) {
    e.preventDefault();
});
$(document).on("click", ".pages-list button", function () {
    if ($(this).parent().hasClass('active')) {
        $(this).parent().removeClass('active')
    } else {
        $(this).parent().addClass('active')
    }
});

$(document).ready(function () {
    var current = window.location.pathname;
    var link;
    $('.pages-list a, .footer a, .site-menu a').each(function () {
        var link = $(this).attr('href');
        if (current == link) {
            $(this).addClass('current');
            $(this).parent().parent().siblings('.hasChildren').addClass('current');
        }
    });
});


$(document).on("click", ".more-less-wrapper .btn-more-less", function () {
    if ($(this).hasClass('active')) {
        $(this).removeClass('active');
        $(this).closest('.more-less-wrapper').removeClass('active');
    } else {
        $(this).addClass('active');
        $(this).closest('.more-less-wrapper').addClass('active');
    }
});
$(document).on("click", ".hasChildren", function () {
    if ($(this).hasClass('active')) {
        $(this).removeClass('active');
    } else {
        $(this).addClass('active');
    }
});




$.fn.isInViewport = function () {
    let elementTop = $(this).offset().top;
    let elementBottom = elementTop + $(this).outerHeight();

    let viewportTop = $(window).scrollTop();
    let viewportBottom = viewportTop + $(window).height();

    return elementBottom > viewportTop && elementTop < viewportBottom;
};

$(window).on('load scroll', function () {
    $('section').each(function (i, el) {
        if ($(this).isInViewport()) {
            setTimeout(() => {
                $(this).addClass('in-view');
                $(this).prevAll().addClass('in-view');
            }, 300);
            // console.log('content block is in viewport.', $(this))
        } else {
            // $(this).removeClass('in-view');
        }
    })

});
