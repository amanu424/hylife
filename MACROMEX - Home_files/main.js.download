$(window).on("scroll", function () {
    if ($(this).scrollTop() > $(window).height() / 5) {
        $(".scrollTop").fadeIn();
    } else {
        $(".scrollTop").fadeOut();
    }
});
$(document).on("click", ".scrollTop", function () {
    $("html, body").animate({
            scrollTop: 0,
        },
        700
    );
    return false;
});


$(window).on('scroll', function () {
    // $('html').removeClass('openMenu');
});

$(document).on('click', '.toggleMenu', function () {
    $('html').removeClass('openSearch');
    if ($('html').hasClass('openMenu')) {
        $('html').removeClass('openMenu');
    } else {
        $('html').removeClass('openSearch').addClass('openMenu');
    }
});

$(document).on("click", ".toggleSearch, .closeSearch", function (e) {
    e.preventDefault();
    $('html').removeClass('openMenu');
    if ($('html').hasClass('openSearch')) {
        $('html').removeClass('openSearch');
    } else {
        $('html').addClass('openSearch');
        $('.header .searchInput').focus();
    }
});

$(document).on("input", ".searchInput", function () {
    if ($(this).val().length > 2) {
        // alert('alert1');
        $(this).parent().siblings('.submit').find('input').removeAttr('disabled');
    } else {
        // alert('alert2'); 
        $(this).parent().siblings('.submit').find('input').attr('disabled', 'disabled');
    }
});

$(document).ready(function () {
    console.log('ok');
    if ($('.searchInput').val().length > 2) {
        $('.searchInput').parent().siblings('.submit').find('input').removeAttr('disabled');
    } else {
        $('.searchInput').parent().siblings('.submit').find('input').attr('disabled', 'disabled');
    }
})

$(window).on("click", function () {
    $('html').removeClass('openSearch');
    $('.pages-list').removeClass('active');
});
$(document).on('click', '.form-search-wrapper, .toggleSearch, .pages-list', function (event) {
    event.stopPropagation();
});

