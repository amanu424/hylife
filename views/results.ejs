<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HyLife - Application Status</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      @keyframes gradientShift {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

      /* Floating particles animation */
      .particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        animation: float 6s infinite linear;
      }

      @keyframes float {
        0% {
          transform: translateY(100vh) rotate(0deg);
          opacity: 1;
        }
        100% {
          transform: translateY(-100px) rotate(360deg);
          opacity: 0;
        }
      }

      /* Header */
      .header {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 10;
      }

      .logo {
        display: flex;
        align-items: center;
        font-size: 1.5rem;
        font-weight: bold;
        color: #2c5aa0;
      }

      .logo::before {
        content: "🌊";
        margin-right: 0.5rem;
        font-size: 1.8rem;
      }

      .login-btn {
        background: #2c5aa0;
        color: white;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 25px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .login-btn:hover {
        background: #1e3d6f;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(44, 90, 160, 0.3);
      }

      /* Main Content */
      .container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 0 1rem;
        position: relative;
        z-index: 5;
      }

      .page-title {
        text-align: center;
        margin-bottom: 2rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        padding: 2rem;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
      }

      .page-title h1 {
        color: #333;
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
      }

      .page-title p {
        color: #666;
        font-size: 1.1rem;
      }

      /* Status Sections */
      .status-section {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
      }

      .status-section:hover {
        transform: translateY(-5px);
      }

      .status-header {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
      }

      .status-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.2rem;
      }

      .accepted .status-icon {
        background: #d4edda;
        color: #155724;
      }

      .pending .status-icon {
        background: #fff3cd;
        color: #856404;
      }

      .rejected .status-icon {
        background: #f8d7da;
        color: #721c24;
      }

      .status-title {
        font-size: 1.5rem;
        font-weight: bold;
        color: #333;
      }

      .status-count {
        color: #666;
        font-size: 0.9rem;
        margin-left: auto;
      }

      /* Applicant Cards */
      .applicant-card {
        background: rgba(248, 249, 250, 0.8);
        border-radius: 15px;
        padding: 1rem;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid transparent;
      }

      .applicant-card:hover {
        background: rgba(255, 255, 255, 0.9);
        border-color: #2c5aa0;
        transform: translateX(5px);
      }

      .applicant-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .applicant-info {
        display: flex;
        align-items: center;
      }

      .applicant-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        margin-right: 1rem;
        background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 1.2rem;
      }

      .applicant-details h3 {
        color: #333;
        margin-bottom: 0.25rem;
      }

      .applicant-country {
        color: #666;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
      }

      .country-flag {
        margin-right: 0.5rem;
        font-size: 1.1rem;
      }

      .expand-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: #666;
        cursor: pointer;
        transition: transform 0.3s ease;
      }

      .expand-btn.expanded {
        transform: rotate(180deg);
      }

      .applicant-expanded {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #e0e0e0;
        display: none;
      }

      .applicant-expanded.show {
        display: block;
        animation: slideDown 0.3s ease;
      }

      @keyframes slideDown {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .detail-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        color: #666;
      }

      /* Footer */
      .footer {
        background: rgba(44, 90, 160, 0.9);
        backdrop-filter: blur(10px);
        color: white;
        text-align: center;
        padding: 2rem;
        margin-top: 3rem;
        position: relative;
        z-index: 10;
      }

      .footer-content {
        max-width: 800px;
        margin: 0 auto;
      }

      .footer h3 {
        margin-bottom: 1rem;
        font-size: 1.5rem;
      }

      .footer p {
        margin-bottom: 1rem;
        opacity: 0.9;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 1rem;
      }

      .footer-links a {
        color: white;
        text-decoration: none;
        transition: opacity 0.3s ease;
      }

      .footer-links a:hover {
        opacity: 0.7;
      }

      /* Floating Action Buttons */
      .floating-buttons {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        z-index: 1000;
      }

      .fab {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .fab-add {
        background: linear-gradient(45deg, #28a745, #20c997);
      }

      .fab-edit {
        background: linear-gradient(45deg, #ffc107, #fd7e14);
      }

      .fab:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.4);
      }

      /* Modal Styles */
      .modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(5px);
      }

      .modal.show {
        display: flex;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.3s ease;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .modal-dialog {
        background: white;
        border-radius: 15px;
        padding: 0;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        animation: slideIn 0.3s ease;
      }

      @keyframes slideIn {
        from {
          transform: translateY(-50px);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      .modal-content {
        padding: 0;
      }

      .modal-header {
        padding: 1.5rem;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .modal-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
      }

      .btn-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #666;
        padding: 0;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.3s ease;
      }

      .btn-close:hover {
        background: #f0f0f0;
        color: #333;
      }

      .modal-body {
        padding: 1.5rem;
      }

      .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #333;
      }

      .form-control,
      .form-select {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s ease;
      }

      .form-control:focus,
      .form-select:focus {
        outline: none;
        border-color: #2c5aa0;
        box-shadow: 0 0 0 3px rgba(44, 90, 160, 0.1);
      }

      .mb-3 {
        margin-bottom: 1rem;
      }

      .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
      }

      .btn-primary {
        background: #2c5aa0;
        color: white;
      }

      .btn-primary:hover {
        background: #1e3d6f;
      }

      .btn-danger {
        background: #dc3545;
        color: white;
      }

      .btn-danger:hover {
        background: #c82333;
      }

      .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .d-flex {
        display: flex;
      }

      .justify-content-between {
        justify-content: space-between;
      }

      .imagesInput {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .cardImg {
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e0e0e0;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .header {
          padding: 1rem;
        }

        .page-title h1 {
          font-size: 2rem;
        }

        .container {
          padding: 0 0.5rem;
        }

        .footer-links {
          flex-direction: column;
          gap: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Floating Particles -->
    <div class="particles" id="particles"></div>

    <% if(!isAuthenticated) { %>
    <!-- Header -->
    <header class="header">
      <div class="logo" id="logo">HyLife</div>
      <button class="login-btn" id="loginBtn" style="display: none;" onclick="openLoginModal()">Login</button>
    </header>
    <% } else  { %>
        <header class="header">
      <div class="logo">HyLife</div>
      <a href="/logout" class="login-btn">Logout</a>
    </header>
    <% } %>
    <!-- Main Content -->
    <div class="container">
      <div class="page-title">
        <h1>Application Status</h1>
        <p>
          Track the status of international job applications from candidates
          worldwide
        </p>
      </div>

      <!-- Accepted Section -->
      <div class="status-section accepted">
        <div class="status-header">
          <div class="status-icon">✓</div>
          <div class="status-title">Accepted</div>
          <div class="status-count"></div>
        </div>

        
      </div>

      <!-- Pending Section -->
      <div class="status-section pending">
        <div class="status-header">
          <div class="status-icon">⏳</div>
          <div class="status-title">Pending</div>
          <div class="status-count">2389 Applications</div>
        </div>

       
      </div>

      <!-- Rejected Section -->
      <div class="status-section rejected">
        <div class="status-header">
          <div class="status-icon">✕</div>
          <div class="status-title">Rejected</div>
          <div class="status-count">2618 Applications</div>
        </div>


      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-content">
        <h3>HyLife Careers</h3>
        <p>
          Building the future of sustainable food production with talented
          individuals from around the world.
        </p>
        <div class="footer-links">
          <a href="#about">About Us</a>
          <a href="#careers">Careers</a>
          <a href="#contact">Contact</a>
          <a href="#privacy">Privacy Policy</a>
        </div>
        <p style="margin-top: 2rem; opacity: 0.7">
          © 2024 HyLife. All rights reserved.
        </p>
      </div>
    </footer>
    <% if(isAuthenticated) { %>

    <!-- Floating Action Buttons -->
    <div class="floating-buttons">
      <button class="fab fab-add" onclick="openAddModal()" title="Add New User">
        +
      </button>
      <button class="fab fab-edit" onclick="openEditModal()" title="Edit User">
        ✏️
      </button>
    </div>
    <% } %>

    <!-- Login Modal -->
    <div class="modal" id="loginModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Login</h5>
            <button
              type="button"
              class="btn-close"
              onclick="closeModal('loginModal')"
            >
              &times;
            </button>
          </div>
          <div class="modal-body">
            <form id="loginForm">
              <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input
                  type="text"
                  class="form-control"
                  id="username"
                  name="username"
                  required
                />
              </div>
              <div class="mb-3" style="display: none">
                <label for="password" class="form-label">Password</label>
                <input
                  type="password"
                  class="form-control"
                  id="password"
                  name="password"
                  hidden
                />
              </div>
              <button type="submit" class="btn btn-primary" style="width: 100%">
                Login
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Add User Modal -->
    <div class="modal" id="addUserModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Add New User</h5>
            <button
              type="button"
              class="btn-close"
              onclick="closeModal('addUserModal')"
            >
              &times;
            </button>
          </div>
          <div class="modal-body">
            <form
              id="addUserForm"
              action="/users"
              method="POST"
              enctype="multipart/form-data"
            >
              <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <input
                  type="text"
                  class="form-control"
                  id="name"
                  name="name"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="age" class="form-label">Age</label>
                <input
                  type="number"
                  class="form-control"
                  id="age"
                  name="age"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="phoneNumber" class="form-label">Phone Number</label>
                <input
                  type="tel"
                  class="form-control"
                  id="phoneNumber"
                  name="phoneNumber"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="image" class="form-label">Image</label>
                <div class="imagesInput">
                  <input
                    type="file"
                    class="form-control"
                    id="image"
                    name="image"
                    accept="image/*"
                    required
                  />
                  <img
                    id="userImageOnForm"
                    src="/placeholder.svg?height=65&width=65"
                    alt="Photo"
                    class="cardImg"
                    width="65"
                    height="65"
                  />
                </div>
              </div>
              <div class="mb-3">
                <label for="status" class="form-label">Status</label>
                <select name="status" class="form-select" id="status" required>
                  <option value="accepted">Accepted</option>
                  <option value="pending">Pending</option>
                  <option value="rejected">Rejected</option>
                </select>
              </div>
              <button
                type="submit"
                class="btn btn-primary"
                id="addUserBtn"
                style="width: 100%"
              >
                Add User
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit User Modal -->
    <div class="modal" id="editUserModal">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Edit User</h5>
            <button
              type="button"
              class="btn-close"
              onclick="closeModal('editUserModal')"
            >
              &times;
            </button>
          </div>
          <div class="modal-body">
            <form id="editUserForm" enctype="multipart/form-data">
              <div class="mb-3">
                <label for="editUserSelect" class="form-label"
                  >Select User</label
                >
                <select class="form-select" id="editUserSelect" required>
                  <option value="">Choose a user...</option>
                  <option value="hiroshi">Hiroshi Tanaka</option>
                  <option value="sophie">Sophie Dubois</option>
                  <option value="priya">Priya Sharma</option>
                  <option value="maria">Maria Rodriguez</option>
                  <option value="emma">Emma Thompson</option>
                  <option value="carlos">Carlos Silva</option>
                  <option value="ahmed">Ahmed Hassan</option>
                  <option value="lars">Lars Andersen</option>
                </select>
              </div>
              <div class="mb-3">
                <label for="editName" class="form-label">Name</label>
                <input
                  type="text"
                  class="form-control"
                  id="editName"
                  name="name"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="editAge" class="form-label">Age</label>
                <input
                  type="number"
                  class="form-control"
                  id="editAge"
                  name="age"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="editPhoneNumber" class="form-label"
                  >Phone Number</label
                >
                <input
                  type="tel"
                  class="form-control"
                  id="editPhoneNumber"
                  name="phoneNumber"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="editImage" class="form-label">Image</label>
                <div class="imagesInput">
                  <input
                    type="file"
                    class="form-control"
                    id="editImage"
                    name="image"
                    accept="image/*"
                  />
                  <img
                    id="updateImage"
                    src="/placeholder.svg?height=65&width=65"
                    alt="Photo"
                    class="cardImg"
                    width="65"
                    height="65"
                  />
                </div>
              </div>
              <div class="mb-3">
                <label for="editStatus" class="form-label">Status</label>
                <select
                  name="status"
                  class="form-select"
                  id="editStatus"
                  required
                >
                  <option value="accepted">Accepted</option>
                  <option value="pending">Pending</option>
                  <option value="rejected">Rejected</option>
                </select>
              </div>
              <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary" id="editUserBtn">
                  Update User
                </button>
                <button
                  type="button"
                  id="deleteUserBtn"
                  class="btn btn-danger"
                  disabled
                >
                  Delete User
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", async function () {
        // Initial API test (as provided by you)

        // Image preview functionality
        const imageInput = document.getElementById("image");
        const imagePreview = document.getElementById("userImageOnForm");
        const editImageInput = document.getElementById("editImage");
        const editImagePreview = document.getElementById("updateImage");

        imageInput.addEventListener("change", function (e) {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
              imagePreview.src = e.target.result;
            };
            reader.readAsDataURL(file);
          }
        });

        editImageInput.addEventListener("change", function (e) {
          const file = e.target.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
              editImagePreview.src = e.target.result;
            };
            reader.readAsDataURL(file);
          }
        });

        // Get users data (mock data for client-side demo)
        // In a real application, this would be fetched from your server.
        let users = []

        users = await JSON.parse(`<%-JSON.stringify(users)%>`);

        // Render users
        function renderUsers() {
          const acceptedSection = document.querySelector(".accepted");
          const pendingSection = document.querySelector(".pending");
          const rejectedSection = document.querySelector(".rejected");

          // Clear existing cards (keep headers)
          acceptedSection
            .querySelectorAll(".applicant-card")
            .forEach((card) => card.remove());
          pendingSection
            .querySelectorAll(".applicant-card")
            .forEach((card) => card.remove());
          rejectedSection
            .querySelectorAll(".applicant-card")
            .forEach((card) => card.remove());

          // Update counts
          const acceptedCount = users.filter(
            (u) => u.status === "accepted"
          ).length;
          const pendingCount = users.filter(
            (u) => u.status === "pending"
          ).length;
          const rejectedCount = users.filter(
            (u) => u.status === "rejected"
          ).length;

          acceptedSection.querySelector(
            ".status-count"
          ).textContent = `${acceptedCount} Applications`;
         
          users.forEach((user, index) => {
            const initials = user.name
              .split(" ")
              .map((n) => n[0])
              .join("");
            const countryMap = {
              "Hiroshi Tanaka": { flag: "🇯🇵", name: "Japan" },
              "Sophie Dubois": { flag: "🇫🇷", name: "France" },
              "Priya Sharma": { flag: "🇮🇳", name: "India" },
              "Maria Rodriguez": { flag: "🇪🇸", name: "Spain" },
              "Emma Thompson": { flag: "🇬🇧", name: "United Kingdom" },
              "Carlos Silva": { flag: "🇧🇷", name: "Brazil" },
              "Ahmed Hassan": { flag: "🇪🇬", name: "Egypt" },
              "Lars Andersen": { flag: "🇩🇰", name: "Denmark" },
            };
            const countryInfo = countryMap[user.name] || {
              flag: "🌍",
              name: "Unknown",
            };

            const userCard = document.createElement("div");
            userCard.className = "applicant-card";
            userCard.onclick = () => toggleUserDetails(user._id); // Use _id for unique identification
            userCard.innerHTML = `
                        <div class="applicant-header">
                            <div class="applicant-info">
                                <div class="applicant-avatar">
                                    <img src='${user.image}' alt='${initials}' width="65" height="65"} /></div>
                                <div class="applicant-details">
                                    <h3>${user.name}</h3>
                                    <div class="applicant-country">
                                        <span class="country-flag">Age: </span>
                                        ${user.age}
                                    </div>
                                </div>
                            </div>
                            <button class="expand-btn" id="chevron${user._id}">▼</button>
                        </div>
                        <div class="applicant-expanded" id="userDetails${user._id}">
                            <div class="detail-row">
                                <span>Age:</span>
                                <span>${user.age}</span>
                            </div>
                            <div class="detail-row">
                                <span>Passport Number:</span>
                                <span>Private</span>
                            </div>
                            <div class="detail-row">
                                <span>Phone:</span>
                                <span>Private</span>
                            </div>
                        </div>
                    `;

            if (user.status === "accepted") {
              acceptedSection.appendChild(userCard);
            } else if (user.status === "pending") {
              pendingSection.appendChild(userCard);
            } else {
              rejectedSection.appendChild(userCard);
            }
          });

          populateEditUserSelect();
        }

        // Toggle user details
        window.toggleUserDetails = function (userId) {
          const details = document.getElementById(`userDetails${userId}`);
          const chevron = document.getElementById(`chevron${userId}`);

          if (details.classList.contains("show")) {
            details.classList.remove("show");
            chevron.classList.remove("expanded");
            chevron.textContent = "▼";
          } else {
            details.classList.add("show");
            chevron.classList.add("expanded");
            chevron.textContent = "▲";
          }
        };

        // Add user form submission
        const addUserForm = document.getElementById("addUserForm");
        addUserForm.addEventListener("submit", async function (e) {
          e.preventDefault();
          const submitBtn = document.getElementById("addUserBtn");
          submitBtn.innerText = "Adding User...";
          submitBtn.disabled = true;

          const formData = new FormData(e.target);
          try {
            const response = await fetch("/users", {
              method: "POST",
              body: formData, // formData directly sends multipart/form-data
            });
            const data = await response.json();
            if (data.success) {
              users.push(data.user);
              renderUsers();
              closeModal("addUserModal");
              this.reset();
              imagePreview.src = "/placeholder.svg?height=65&width=65";
              alert("User added successfully!");
            } else {
              console.log(data);
              throw new Error(data.message);
            }
          } catch (error) {
            // Fallback for client-side demo if no server is running
            console.error("Error adding user (server-side):", error);
            alert("Try again");
          } finally {
            submitBtn.innerText = "Add User";
            submitBtn.disabled = false;
          }
        });

        // Populate edit user select
        function populateEditUserSelect() {
          const select = document.getElementById("editUserSelect");
          select.innerHTML = '<option value="">Select a user</option>';
          users.forEach((user) => {
            select.innerHTML += `<option value="${user._id}">${user.name}</option>`;
          });
        }

        // Edit user form handling
        const editUserSelect = document.getElementById("editUserSelect");
        const editUserForm = document.getElementById("editUserForm");
        const deleteUserBtn = document.getElementById("deleteUserBtn");
        const editUserBtn = document.getElementById("editUserBtn");

        editUserSelect.addEventListener("change", function () {
          const selectedUser = users.find((u) => u._id === this.value);
          if (selectedUser) {
            document.getElementById("editName").value = selectedUser.name;
            document.getElementById("editAge").value = selectedUser.age;
            document.getElementById("editPhoneNumber").value =
              selectedUser.phoneNumber;
            document.getElementById("editStatus").value = selectedUser.status;
            editImagePreview.src = selectedUser.image;
            deleteUserBtn.disabled = false;
          } else {
            // Clear form fields if no user is selected
            document.getElementById("editName").value = "";
            document.getElementById("editAge").value = "";
            document.getElementById("editPhoneNumber").value = "";
            document.getElementById("editStatus").value = "accepted"; // Default status
            editImagePreview.src = "/placeholder.svg?height=65&width=65";
            deleteUserBtn.disabled = true;
          }
        });

        editUserForm.addEventListener("submit", async function (e) {
          e.preventDefault();
          const selectedId = editUserSelect.value;
          editUserBtn.innerText = "Updating...";
          editUserBtn.disabled = true;
          deleteUserBtn.disabled = true;

          const formData = new FormData(this);
          // The image file is automatically included in formData.
          try {
            const response = await fetch(`/users/${selectedId}`, {
              method: "PUT",
              body: formData,
            });
            const data = await response.json();

            if (data.success) {
              const userIndex = users.findIndex((u) => u._id === selectedId);
              if (userIndex !== -1) {
                users[userIndex] = data.user;
                renderUsers();
                closeModal("editUserModal");
                this.reset();
                editImagePreview.src = "/placeholder.svg?height=65&width=65";
                alert("User updated successfully!");
              }
            } else {
              throw new Error(data.message);
            }
          } catch (error) {
            // Fallback for client-side demo if no server is running
            console.error("Error updating user (server-side):", error);
            const userIndex = users.findIndex((u) => u._id === selectedId);
            if (userIndex !== -1) {
              users[userIndex] = {
                ...users[userIndex],
                name: formData.get("name"),
                age: parseInt(formData.get("age")),
                phoneNumber: formData.get("phoneNumber"),
                status: formData.get("status"),
                image: editImagePreview.src, // Use the base64 image for client-side display
              };
              renderUsers();
              closeModal("editUserModal");
              this.reset();
              editImagePreview.src = "/placeholder.svg?height=65&width=65";
              alert("User updated successfully (client-side demo)!");
            }
          } finally {
            editUserBtn.innerText = "Update User";
            editUserBtn.disabled = false;
            deleteUserBtn.disabled = false;
          }
        });

        // Delete user
        deleteUserBtn.addEventListener("click", async function () {
          const selectedId = editUserSelect.value;
          if (confirm("Are you sure you want to delete this user?")) {
            deleteUserBtn.innerText = "Deleting...";
            deleteUserBtn.disabled = true;
            editUserBtn.disabled = true;

            try {
              const response = await fetch(`/users/${selectedId}`, {
                method: "DELETE",
              });

              if (response.ok) {
                users = users.filter((u) => u._id !== selectedId);
                renderUsers();
                closeModal("editUserModal");
                editUserForm.reset();
                editImagePreview.src = "/placeholder.svg?height=65&width=65";
                alert("User deleted successfully!");
              } else {
                throw new Error("Failed to delete user");
              }
            } catch (error) {
              // Fallback for client-side demo if no server is running
              console.error("Error deleting user (server-side):", error);
              users = users.filter((u) => u._id !== selectedId);
              renderUsers();
              closeModal("editUserModal");
              editUserForm.reset();
              editImagePreview.src = "/placeholder.svg?height=65&width=65";
              alert("User deleted successfully (client-side demo)!");
            } finally {
              deleteUserBtn.innerText = "Delete User";
              deleteUserBtn.disabled = false;
              editUserBtn.disabled = false;
            }
          }
        });

        // Login form handling
        const loginForm = document.getElementById("loginForm");
        loginForm.addEventListener("submit", async function (e) {
          e.preventDefault();
          try {
            const formData = new FormData(e.target);
            const username = document.getElementById("username").value;
            console.log(username);
            const response = await fetch("/login", {
              method: "POST",
              headers: {
                "Content-Type": "application/json", // Important!
              },
              body: JSON.stringify({ username }),
            });
            const data = await response.json();
            if (data.success) {
              window.location.reload();
            } else {
              throw new Error(data.message);
            }
          } catch (error) {
            alert("Login failed: " + error.message);
          }
        });

        // Modal functions (keeping existing functionality)
        window.openLoginModal = function () {
          document.getElementById("loginModal").classList.add("show");
        };



        window.openAddModal = function () {
          document.getElementById("addUserModal").classList.add("show");
        };

        window.openEditModal = function () {
          document.getElementById("editUserModal").classList.add("show");
        };

        window.closeModal = function (modalId) {
          document.getElementById(modalId).classList.remove("show");
        };

        // Close modal when clicking outside
        window.addEventListener("click", function (event) {
          const modals = document.querySelectorAll(".modal");
          modals.forEach((modal) => {
            if (event.target === modal) {
              modal.classList.remove("show");
            }
          });
        });

        // Create floating particles (keeping existing functionality)
        function createParticles() {
          const particlesContainer = document.getElementById("particles");
          const particleCount = 50;

          for (let i = 0; i < particleCount; i++) {
            const particle = document.createElement("div");
            particle.className = "particle";
            particle.style.left = Math.random() * 100 + "%";
            particle.style.animationDelay = Math.random() * 6 + "s";
            particle.style.animationDuration = Math.random() * 3 + 3 + "s";
            particlesContainer.appendChild(particle);
          }
        }

        // when logo double click the login
        function showLoginButton() {
          document.getElementById("loginBtn").style.display = "block"
        }
        document.getElementById("logo").addEventListener("dblclick", showLoginButton);
        
        // Initialize particles
        createParticles();

        // Initial render
        renderUsers();
      });
    </script>
  </body>
</html>
